---
import BlogList from "../../../components/BlogList.astro"
import { getCollection } from "astro:content"

export async function getStaticPaths() {
  const allPosts = await getCollection("blog")
  const publishedPosts = allPosts
    .filter((post) => !post.data.draft)
    .sort(
      (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
    )

  const PAGE_SIZE = 6
  const totalPages = Math.ceil(publishedPosts.length / PAGE_SIZE)
  const allTags = Array.from(
    new Set(publishedPosts.map((p) => p.data.tag).filter(Boolean) as string[])
  ).sort()

  const paths = []
  for (let i = 2; i <= totalPages; i++) {
    const prevUrl = i === 2 ? "/blog/" : `/blog/page/${i - 1}/`
    const nextUrl = i < totalPages ? `/blog/page/${i + 1}/` : null
    const posts = publishedPosts.slice((i - 1) * PAGE_SIZE, i * PAGE_SIZE)

    paths.push({
      params: { page: String(i) },
      props: {
        posts,
        allTags,
        currentPage: i,
        totalPages,
        totalPosts: publishedPosts.length,
        prevUrl,
        nextUrl,
      },
    })
  }

  return paths
}

const {
  posts,
  allTags,
  currentPage,
  totalPages,
  totalPosts,
  prevUrl,
  nextUrl,
} = Astro.props
---

<BlogList
  posts={posts}
  allTags={allTags}
  currentPage={currentPage}
  totalPages={totalPages}
  totalPosts={totalPosts}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
/>
