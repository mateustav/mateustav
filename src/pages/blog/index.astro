---
import BlogList from "../../components/BlogList.astro"
import { getCollection } from "astro:content"

const allPosts = await getCollection("blog")
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )

const PAGE_SIZE = 6
const totalPages = Math.max(1, Math.ceil(publishedPosts.length / PAGE_SIZE))
const currentPage = 1
const posts = publishedPosts.slice(0, PAGE_SIZE)
const allTags = Array.from(
  new Set(publishedPosts.map((p) => p.data.tag).filter(Boolean) as string[])
).sort()

const nextUrl = totalPages > 1 ? "/blog/page/2/" : null
---

<BlogList
  posts={posts}
  allTags={allTags}
  currentPage={currentPage}
  totalPages={totalPages}
  totalPosts={publishedPosts.length}
  prevUrl={null}
  nextUrl={nextUrl}
/>
