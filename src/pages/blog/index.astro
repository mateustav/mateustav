---
import Layout from "../../layouts/Layout.astro"
import { getCollection } from "astro:content"

const allPosts = await getCollection("blog")
const publishedPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  )

const formattedPosts = publishedPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  tag: post.data.tag ? `#${post.data.tag}` : null,
  rawTag: post.data.tag ? post.data.tag.toLowerCase() : "",
  formattedDate: new Date(post.data.date).toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  }),
  excerpt: (post.body || "").slice(0, 220).replace(/[#*`]/g, "") + "...",
}))

const allTags = Array.from(
  new Set(publishedPosts.map((p) => p.data.tag).filter(Boolean))
).sort()
---

<Layout
  title="Blog & Articles | Mateus Tavares"
  description="Articles and tutorials on full-stack web engineering, Ruby on Rails, React, and digital tools."
>
  <div class="blog-page">
    <div class="container">
      <div class="page-header">
        <h1 class="page-title">Blog &amp; Articles</h1>
        <p class="page-subtitle">
          Insights on full-stack web engineering, Ruby on Rails, frontend craft,
          and software experiments.
        </p>
      </div>

      {
        allTags.length > 0 && (
          <div class="tag-filter-bar">
            <span class="filter-label">Filter:</span>
            <button class="tag-btn active" data-tag="all">
              All Posts ({publishedPosts.length})
            </button>
            {allTags.map((tag) => (
              <button class="tag-btn" data-tag={tag ? tag.toLowerCase() : ""}>
                #{tag}
              </button>
            ))}
          </div>
        )
      }

      {
        formattedPosts.length > 0 ? (
          <div class="posts-list">
            {formattedPosts.map((post) => (
              <article class="post-item" data-tag={post.rawTag}>
                <div class="post-header-line">
                  <time class="post-date">{post.formattedDate}</time>
                  {post.tag && <span class="badge">{post.tag}</span>}
                </div>

                <h2 class="post-title">
                  <a href={`/blog/${post.id}/`}>{post.title}</a>
                </h2>

                <p class="post-excerpt">{post.excerpt}</p>

                <a href={`/blog/${post.id}/`} class="read-link">
                  Read Article &rarr;
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-blog-box">
            <h3>Articles coming soon!</h3>
            <p>
              I'm currently working on new write-ups about full-stack
              engineering, web performance, and software craft. Check back soon!
            </p>
          </div>
        )
      }
    </div>
  </div>
</Layout>

<script>
  const tagBtns = document.querySelectorAll(".tag-btn")
  const postItems = document.querySelectorAll(".post-item")

  tagBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      tagBtns.forEach((b) => b.classList.remove("active"))
      btn.classList.add("active")

      const selectedTag = btn.getAttribute("data-tag")

      postItems.forEach((item) => {
        const itemEl = item as HTMLElement
        const itemTag = itemEl.getAttribute("data-tag")

        if (selectedTag === "all" || itemTag === selectedTag) {
          itemEl.style.display = "block"
        } else {
          itemEl.style.display = "none"
        }
      })
    })
  })
</script>

<style>
  .blog-page {
    padding: 3.5rem 0 5rem 0;
  }

  .page-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem auto;
  }

  .page-title {
    font-size: 2.75rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .page-subtitle {
    color: var(--text-primary);
    font-size: 1.125rem;
    line-height: 1.6;
  }

  .tag-filter-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 3rem;
  }

  .filter-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-right: 0.5rem;
  }

  .tag-btn {
    background-color: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
    padding: 0.4rem 0.85rem;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .tag-btn:hover {
    color: var(--text-primary);
    border-color: var(--brand-sage);
  }

  .tag-btn.active {
    background-color: var(--brand-sage);
    color: var(--text-primary);
    border-color: var(--brand-sage);
  }

  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .post-item {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 2rem;
    transition: all 0.2s ease;
  }

  .post-item:hover {
    border-color: var(--brand-sage);
    background-color: var(--bg-subtle);
  }

  .post-header-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--text-primary);
  }

  .post-title {
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .post-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .post-title a:hover {
    color: var(--brand-sage);
  }

  .post-excerpt {
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .read-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--brand-sage);
    display: inline-flex;
    align-items: center;
  }

  .empty-blog-box {
    text-align: center;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 3rem 2rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .empty-blog-box h3 {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .empty-blog-box p {
    color: var(--text-primary);
    font-size: 0.95rem;
  }
</style>
