---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faGithub, faLinkedin } from '@fortawesome/free-brands-svg-icons';

const currentYear = new Date().getFullYear();
const githubSvg = icon(faGithub)?.html[0] || '';
const linkedinSvg = icon(faLinkedin)?.html[0] || '';
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-left">
      <p class="copyright">&copy; {currentYear} Mateus Tavares. All rights reserved.</p>
      <p class="tagline">Built with Astro 7 &amp; TypeScript. Hosted on Cloudflare Pages.</p>
    </div>

    <div class="footer-socials">
      <a href="https://github.com/mateustav" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="social-link">
        <Fragment set:html={githubSvg} />
      </a>
      <a href="https://www.linkedin.com/in/mateustav/" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="social-link">
        <Fragment set:html={linkedinSvg} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--bg-app);
    border-top: 1px solid var(--border-color);
    padding: 2.5rem 0;
    margin-top: 5rem;
  }

  .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .copyright {
    color: var(--text-primary);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .tagline {
    color: var(--text-primary);
    opacity: 0.6;
    font-size: 0.8125rem;
    margin-top: 0.25rem;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .social-link {
    color: var(--text-primary);
    opacity: 0.8;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    transition: all 0.2s ease;
  }

  .social-link :global(svg) {
    width: 20px;
    height: 20px;
    display: block;
  }

  .social-link:hover {
    color: var(--brand-gold);
    opacity: 1;
  }
</style>
