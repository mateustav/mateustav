---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-left">
      <p class="copyright">&copy; {currentYear} Mateus Tavares. All rights reserved.</p>
      <p class="tagline">Built with Astro 5 &amp; TypeScript. Hosted on Cloudflare Pages.</p>
    </div>

    <div class="footer-socials">
      <a href="https://github.com/mateustav" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="https://blog.wishpond.com" target="_blank" rel="noopener noreferrer" aria-label="Wishpond Blog">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 15h-2v-6h2v6zm-1-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm5 7h-2v-3c0-.55-.45-1-1-1s-1 .45-1 1v3h-2v-6h2v1.1c.42-.6 1.15-1.1 2-1.1 1.65 0 3 1.35 3 3v3z"/></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: #080c14;
    border-top: 1px solid #1e293b;
    padding: 2.5rem 0;
    margin-top: 5rem;
  }

  .footer-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .copyright {
    color: #cbd5e1;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .tagline {
    color: #64748b;
    font-size: 0.8125rem;
    margin-top: 0.25rem;
  }

  .footer-socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .footer-socials a {
    color: #94a3b8;
    transition: color 0.2s ease;
  }

  .footer-socials a:hover {
    color: #38bdf8;
  }
</style>
