---
import { icon } from '@fortawesome/fontawesome-svg-core';
import {
  faReact,
  faJs,
  faNodeJs,
  faHtml5,
  faCss3Alt,
  faDocker,
  faWordpress,
  faSquareJs
} from '@fortawesome/free-brands-svg-icons';
import { faGem, faCode, faRocket } from '@fortawesome/free-solid-svg-icons';

const getSvg = (faIcon) => {
  const iObj = icon(faIcon);
  return iObj ? iObj.html[0] : '';
};

const technologies = [
  {
    name: 'TypeScript',
    color: '#3178c6',
    svg: `<svg aria-hidden="true" focusable="false" data-prefix="fab" data-icon="typescript" class="svg-inline--fa" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path fill="currentColor" d="M32 32h448v448H32V32zm264.4 280c-5.8-10.7-14.8-17.7-27.1-21.2-4.7-1.3-17.7-2.7-28.9-3.1-24.6-.9-35.8-5.8-35.8-15.7 0-9.8 8.9-15.7 24.1-15.7 15.6 0 24.1 5.4 29.5 18.3 1.8 4.5 4.5 6.3 9.4 6.3h28.1c5.4 0 8-2.7 7.1-7.6-3.1-18.8-15.2-34.4-33-41.5-12.1-4.9-25-6.7-43.3-6.7-21 0-38.4 4.9-49.6 14.3-13.4 11.2-20.1 26.8-20.1 46.9 0 17 4.9 30.4 14.7 39.7 10.3 9.8 24.1 15.2 46.4 17.4 23.2 2.2 32.6 6.3 35.7 15.6 3.1 9.4-1.3 18.8-12.5 22.8-6.3 2.2-16.1 3.1-26.8 2.2-16.5-1.3-26.8-7.1-33-19.2-2.2-4.5-5.4-6.7-9.8-6.7h-29.5c-4.9 0-7.6 2.7-6.7 7.6 4.9 24.6 20.1 41.5 43.8 48.2 11.2 3.1 29.5 4.5 45.5 2.7 22.3-2.2 39.7-8.9 50.9-19.6 13.4-12.5 20.1-28.6 20.1-47.8 0-19.6-5.8-34.8-16.5-44.2zm114.7-96h-116.1c-4.9 0-7.6 2.7-7.6 7.6v27.2c0 4.9 2.7 7.6 7.6 7.6h36.6v150c0 4.9 2.7 7.6 7.6 7.6h33.9c4.9 0 7.6-2.7 7.6-7.6v-150h30.4c4.9 0 7.6-2.7 7.6-7.6V223.6c0-4.9-2.7-7.6-7.6-7.6z"/></svg>`
  },
  {
    name: 'React',
    color: '#61dafb',
    svg: getSvg(faReact)
  },
  {
    name: 'Ruby on Rails',
    color: '#cc0000',
    svg: getSvg(faGem)
  },
  {
    name: 'JavaScript',
    color: '#f7df1e',
    svg: getSvg(faJs)
  },
  {
    name: 'Node.js',
    color: '#5fa04e',
    svg: getSvg(faNodeJs)
  },
  {
    name: 'Astro',
    color: '#ff5d01',
    svg: getSvg(faRocket)
  },
  {
    name: 'HTML5',
    color: '#e34f26',
    svg: getSvg(faHtml5)
  },
  {
    name: 'CSS3',
    color: '#1572b6',
    svg: getSvg(faCss3Alt)
  },
  {
    name: 'Docker',
    color: '#2496ed',
    svg: getSvg(faDocker)
  },
  {
    name: 'WordPress',
    color: '#21759b',
    svg: getSvg(faWordpress)
  }
];
---

<section class="tech-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Core Technology Stack</h2>
      <p class="section-subtitle">Languages, frameworks, and dev tools I use regularly</p>
    </div>

    <div class="tech-grid">
      {technologies.map((tech) => (
        <div class="tech-card" title={tech.name}>
          <div class="tech-icon-container" style={`color: ${tech.color}`}>
            <Fragment set:html={tech.svg} />
          </div>
          <span class="tech-name">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-section {
    padding: 3rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 1.85rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    color: #94a3b8;
    font-size: 1rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 1.25rem;
  }

  .tech-card {
    background-color: #151d2a;
    border: 1px solid #232d3f;
    border-radius: 0.75rem;
    padding: 1.25rem 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    transition: all 0.2s ease;
  }

  .tech-card:hover {
    border-color: #38bdf8;
    background-color: #1c2638;
    transform: translateY(-2px);
  }

  .tech-icon-container {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tech-icon-container :global(svg) {
    width: 36px;
    height: 36px;
    display: block;
    max-width: 100%;
    max-height: 100%;
  }

  .tech-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #cbd5e1;
    text-align: center;
  }
</style>
