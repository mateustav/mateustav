---
import { icon } from '@fortawesome/fontawesome-svg-core';
import {
  faReact,
  faJs,
  faSquareJs,
  faNodeJs,
  faHtml5,
  faCss3Alt,
  faDocker,
  faWordpress,
} from '@fortawesome/free-brands-svg-icons';

const getSvg = (faIcon) => {
  const iObj = icon(faIcon);
  return iObj ? iObj.html[0] : '';
};

const technologies = [
  {
    name: 'TypeScript',
    color: '#3178c6',
    svg: `<svg aria-hidden="true" focusable="false" class="svg-inline--fa" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor"><path d="M400 32H48C21.5 32 0 53.5 0 80v352c0 26.5 21.5 48 48 48h352c26.5 0 48-21.5 48-48V80c0-26.5-21.5-48-48-48zM242 380h-35v-135h-45v-30h125v30h-45v135zm115 5c-30 0-50-15-60-35l28-16c7 12 18 20 34 20 15 0 24-7 24-16 0-11-9-15-30-24l-10-4c-30-13-50-28-50-60 0-30 24-52 60-52 27 0 45 10 56 30l-25 15c-6-10-15-15-30-15-14 0-22 6-22 15 0 10 8 14 28 22l10 4c35 15 52 30 52 62 0 35-27 56-62 56z"/></svg>`
  },
  {
    name: 'React',
    color: '#61dafb',
    svg: getSvg(faReact)
  },
  {
    name: 'Ruby on Rails',
    color: '#CC0000',
    svg: `<svg version="1.1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 122.88 75.42"><path fill="#CC0000" d="M3.79,75.42h42.8c0,0-8.18-37.33,18.91-52.45c5.91-2.87,24.71-13.6,55.48,9.16c0.98-0.81,1.9-1.46,1.9-1.46 S94.71,2.55,63.34,5.69C47.52,7.1,28.12,21.46,16.74,40.42C5.54,59.08,3.84,74.92,3.79,75.41L3.79,75.42L3.79,75.42z M48.22,64.58 c0.11,2.87,0.38,5.2,0.65,6.83l6.5,2.33c-0.49-2.11-0.98-4.5-1.3-7.04L48.22,64.58L48.22,64.58z M8.94,49.3l-6.23-2.28 c-1.03,2.33-2.17,5.04-2.71,6.5l6.23,2.28C6.93,53.96,8.07,51.31,8.94,49.3L8.94,49.3z M25.3,25.09l-3.85-3.36 c-1.41,1.35-2.76,2.71-4.01,4.06l4.17,3.58C22.76,27.9,24,26.44,25.3,25.09L25.3,25.09z M49.03,50.82l4.39,3.47 c0.22-2.11,0.6-4.23,1.14-6.34l-3.9-3.09C49.95,46.87,49.47,48.87,49.03,50.82L49.03,50.82z M56.89,33.37l2.6,3.9 c0.92-1.35,2-2.6,3.2-3.85l-2.44-3.68C59,30.88,57.86,32.13,56.89,33.37L56.89,33.37z M45.78,8.99l-2.44-3.74 c-1.35,0.7-2.76,1.46-4.23,2.33l2.49,3.79C43.02,10.51,44.37,9.7,45.78,8.99L45.78,8.99z M70.38,23.24l1.25,3.74 c1.57-0.76,3.14-1.41,4.71-1.9l-1.19-3.58C73.31,22.05,71.73,22.65,70.38,23.24L70.38,23.24z M67.78,3.3c0.16,0,0.38,0,0.54,0 L67.24,0c-1.68,0-3.41,0.11-5.2,0.33l1.03,3.2C64.64,3.36,66.21,3.3,67.78,3.3L67.78,3.3z M87.83,20.21l-0.22,3.41 c1.79,0.05,3.58,0.27,5.36,0.65l0.22-3.36C91.35,20.53,89.56,20.32,87.83,20.21L87.83,20.21z M92.97,8.72l0.22-3.63 c-0.49-0.27-1.84-0.92-5.26-1.9l-0.22,3.58C89.5,7.37,91.24,8.02,92.97,8.72L92.97,8.72z"/></svg>`
  },
  {
    name: 'JavaScript',
    color: '#f7df1e',
    svg: getSvg(faSquareJs) || getSvg(faJs)
  },
  {
    name: 'Node.js',
    color: '#5fa04e',
    svg: getSvg(faNodeJs)
  },
  {
    name: 'Astro',
    color: '#ff5d01',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><path fill="#ff5d01" d="M84.094 90.074c-3.57 3.055-10.696 5.137-18.903 5.137-10.07 0-18.515-3.137-20.754-7.356-.8 2.418-.98 5.184-.98 6.954 0 0-.527 8.675 5.508 14.71a5.671 5.671 0 0 1 5.672-5.671c5.37 0 5.367 4.683 5.363 8.488v.336c0 5.773 3.527 10.719 8.543 12.805a11.62 11.62 0 0 1-1.172-5.098c0-5.508 3.23-7.555 6.988-9.938 2.989-1.894 6.309-4 8.594-8.222a15.513 15.513 0 0 0 1.875-7.41 15.55 15.55 0 0 0-.734-4.735Zm0 0"/><path fill="var(--text-primary)" d="M81.504 9.465c.973 1.207 1.469 2.836 2.457 6.09l21.656 71.136a90.079 90.079 0 0 0-25.89-8.765L65.629 30.28a1.833 1.833 0 0 0-3.52.004L48.18 77.902a90.104 90.104 0 0 0-26.003 8.778l21.758-71.14c.996-3.25 1.492-4.876 2.464-6.083a8.023 8.023 0 0 1 3.243-2.398c1.433-.575 3.136-.575 6.535-.575H71.72c3.402 0 5.105 0 6.543.579a7.988 7.988 0 0 1 3.242 2.402Zm0 0"/></svg>`
  },
  {
    name: 'HTML5',
    color: '#e34f26',
    svg: getSvg(faHtml5)
  },
  {
    name: 'CSS3',
    color: '#1572b6',
    svg: getSvg(faCss3Alt)
  },
  {
    name: 'Docker',
    color: '#2496ed',
    svg: getSvg(faDocker)
  },
  {
    name: 'GraphQL',
    color: '#E535AB',
    svg: `<svg xmlns="http://www.w3.org/2000/svg" version="1.1" viewBox="0 0 400 400"><g><g><rect x="122" y="-0.4" transform="matrix(-0.866 -0.5 0.5 -0.866 163.3196 363.3136)" fill="#E535AB" width="16.6" height="320.3"/></g><g><rect x="39.8" y="272.2" fill="#E535AB" width="320.3" height="16.6"/></g><g><rect x="37.9" y="312.2" transform="matrix(-0.866 -0.5 0.5 -0.866 83.0693 663.3409)" fill="#E535AB" width="185" height="16.6"/></g><g><rect x="177.1" y="71.1" transform="matrix(-0.866 -0.5 0.5 -0.866 463.3409 283.0693)" fill="#E535AB" width="185" height="16.6"/></g><g><rect x="122.1" y="-13" transform="matrix(-0.5 -0.866 0.866 -0.5 126.7903 232.1221)" fill="#E535AB" width="16.6" height="185"/></g><g><rect x="109.6" y="151.6" transform="matrix(-0.5 -0.866 0.866 -0.5 266.0828 473.3766)" fill="#E535AB" width="320.3" height="16.6"/></g><g><rect x="52.5" y="107.5" fill="#E535AB" width="16.6" height="185"/></g><g><rect x="330.9" y="107.5" fill="#E535AB" width="16.6" height="185"/></g><g><rect x="262.4" y="240.1" transform="matrix(-0.5 -0.866 0.866 -0.5 126.7953 714.2875)" fill="#E535AB" width="14.5" height="160.9"/></g><path fill="#E535AB" d="M369.5,297.9c-9.6,16.7-31,22.4-47.7,12.8c-16.7-9.6-22.4-31-12.8-47.7c9.6-16.7,31-22.4,47.7-12.8 C373.5,259.9,379.2,281.2,369.5,297.9"/><path fill="#E535AB" d="M90.9,137c-9.6,16.7-31,22.4-47.7,12.8c-16.7-9.6-22.4-31-12.8-47.7c9.6-16.7,31-22.4,47.7-12.8 C94.8,99,100.5,120.3,90.9,137"/><path fill="#E535AB" d="M30.5,297.9c-9.6-16.7-3.9-38,12.8-47.7c16.7-9.6,38-3.9,47.7,12.8c9.6,16.7,3.9,38-12.8,47.7 C61.4,320.3,40.1,314.6,30.5,297.9"/><path fill="#E535AB" d="M309.1,137c-9.6-16.7-3.9-38,12.8-47.7c16.7-9.6,38-3.9,47.7,12.8c9.6,16.7,3.9,38-12.8,47.7 C340.1,159.4,318.7,153.7,309.1,137"/><path fill="#E535AB" d="M200,395.8c-19.3,0-34.9-15.6-34.9-34.9c0-19.3,15.6-34.9,34.9-34.9c19.3,0,34.9,15.6,34.9,34.9 C234.9,380.1,219.3,395.8,200,395.8"/><path fill="#E535AB" d="M200,74c-19.3,0-34.9-15.6-34.9-34.9c0-19.3,15.6-34.9,34.9-34.9c19.3,0,34.9,15.6,34.9,34.9 C234.9,58.4,219.3,74,200,74"/></g></svg>`
  },
  {
    name: 'WordPress',
    color: '#21759b',
    svg: getSvg(faWordpress)
  }
];

const duplicatedTech = [...technologies, ...technologies];
---

<section class="tech-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Core Technology Stack</h2>
      <p class="section-subtitle">Languages, frameworks, and dev tools I use regularly</p>
    </div>

    <!-- Desktop Balanced Grid Layout (6 items top, 5 items bottom) -->
    <div class="tech-desktop-grid">
      <div class="tech-row">
        {technologies.slice(0, 6).map((tech) => (
          <div class="tech-card" title={tech.name}>
            <div class="tech-icon-container" style={`color: ${tech.color}`}>
              <Fragment set:html={tech.svg} />
            </div>
            <span class="tech-name">{tech.name}</span>
          </div>
        ))}
      </div>
      <div class="tech-row">
        {technologies.slice(6).map((tech) => (
          <div class="tech-card" title={tech.name}>
            <div class="tech-icon-container" style={`color: ${tech.color}`}>
              <Fragment set:html={tech.svg} />
            </div>
            <span class="tech-name">{tech.name}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile Zero-JS Pure CSS Infinite Carousel -->
    <div class="tech-mobile-carousel">
      <div class="carousel-track">
        {duplicatedTech.map((tech) => (
          <div class="tech-card carousel-card" title={tech.name}>
            <div class="tech-icon-container" style={`color: ${tech.color}`}>
              <Fragment set:html={tech.svg} />
            </div>
            <span class="tech-name">{tech.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .tech-section {
    padding: 3rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 1.85rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    color: var(--text-primary);
    font-size: 1rem;
  }

  /* Desktop Balanced Layout */
  .tech-desktop-grid {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
  }

  .tech-row {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    width: 100%;
    flex-wrap: wrap;
  }

  .tech-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 0.85rem;
    padding: 1.25rem 0.85rem;
    width: 115px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .tech-card:hover {
    border-color: var(--brand-gold);
    background-color: var(--bg-subtle);
    transform: translateY(-2px);
  }

  .tech-icon-container {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tech-icon-container :global(svg) {
    width: 36px;
    height: 36px;
    display: block;
    max-width: 100%;
    max-height: 100%;
  }

  .tech-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
    text-align: center;
  }

  /* Hide mobile carousel on desktop */
  .tech-mobile-carousel {
    display: none;
  }

  /* Mobile Pure CSS Infinite Carousel */
  @media (max-width: 768px) {
    .tech-desktop-grid {
      display: none;
    }

    .tech-mobile-carousel {
      display: block;
      width: 100%;
      overflow: hidden;
      mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
      -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
      padding: 0.5rem 0;
    }

    .carousel-track {
      display: flex;
      gap: 1rem;
      width: max-content;
      animation: infinite-scroll 25s linear infinite;
    }

    .carousel-track:hover,
    .carousel-track:active {
      animation-play-state: paused;
    }

    .carousel-card {
      width: 105px;
      padding: 1rem 0.5rem;
    }
  }

  @keyframes infinite-scroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
