---

<section class="tech-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Core Technology Stack</h2>
      <p class="section-subtitle">Languages, frameworks, and dev tools I use regularly</p>
    </div>

    <div class="tech-grid">
      {technologies.map((tech) => (
        <div class="tech-card" title={tech.name}>
          <div class="tech-icon" style={`color: ${tech.color}`}>
            <Fragment set:html={tech.svg} />
          </div>
          <span class="tech-name">{tech.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .tech-section {
    padding: 3rem 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .section-title {
    font-size: 1.85rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    color: #94a3b8;
    font-size: 1rem;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 1.25rem;
  }

  .tech-card {
    background-color: #151d2a;
    border: 1px solid #232d3f;
    border-radius: 0.75rem;
    padding: 1.25rem 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    transition: all 0.2s ease;
  }

  .tech-card:hover {
    border-color: #38bdf8;
    background-color: #1c2638;
    transform: translateY(-2px);
  }

  .tech-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .tech-icon svg {
    width: 44px;
    height: 44px;
    display: block;
  }

  .tech-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #cbd5e1;
    text-align: center;
  }
</style>
