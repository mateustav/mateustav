---

---

<form id="contact-form" action="/api/submit" method="POST" class="contact-form">
  <!-- Honeypot field to prevent spam bots -->
  <div class="form-group honeypot" style="display: none;">
    <label for="bot_field">Leave this field blank</label>
    <input
      type="text"
      id="bot_field"
      name="bot_field"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="form-group">
    <label for="name">Name</label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="Johnny Cash"
      required
      class="form-control"
    />
  </div>

  <div class="form-group">
    <label for="email">Email Address</label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder="johnny@maninblack.com"
      required
      class="form-control"
    />
  </div>

  <div class="form-group">
    <label for="message">Your Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      placeholder="Hello Mat, I'd love to chat about..."
      required
      class="form-control"></textarea>
  </div>

  <div class="form-actions">
    <button type="submit" id="submit-btn" class="btn btn-primary">
      <svg
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        ><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path></svg>
      Send Message
    </button>
  </div>

  <div id="form-status" class="form-status"></div>
</form>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement
  const statusDiv = document.getElementById("form-status") as HTMLDivElement
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault()

      if (submitBtn) submitBtn.disabled = true
      if (statusDiv) {
        statusDiv.className = "form-status status-pending"
        statusDiv.textContent = "Sending message..."
      }

      const formData = new FormData(form)

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json",
          },
        })

        type FormResponse = { message?: string }
        const result = (await response.json().catch(() => ({}))) as FormResponse

        if (response.ok) {
          if (statusDiv) {
            statusDiv.className = "form-status status-success"
            statusDiv.textContent =
              "Thank you! Your message was sent successfully."
          }
          form.reset()
        } else {
          if (statusDiv) {
            statusDiv.className = "form-status status-error"
            statusDiv.textContent =
              result.message || "Something went wrong. Please try again later."
          }
        }
      } catch (err) {
        if (statusDiv) {
          statusDiv.className = "form-status status-error"
          statusDiv.textContent =
            "Unable to send message directly. Please feel free to reach out directly via email."
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false
      }
    })
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    background-color: var(--bg-app);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.9375rem;
    transition: border-color 0.2s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: var(--brand-sage);
  }

  .form-control::placeholder {
    color: var(--text-primary);
    opacity: 0.5;
  }

  textarea.form-control {
    resize: vertical;
    min-height: 120px;
  }

  .form-actions {
    display: flex;
    justify-content: flex-start;
  }

  .form-status {
    min-height: 2rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    display: none;
  }

  .status-pending {
    display: block;
    background-color: var(--bg-subtle);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .status-success {
    display: block;
    background-color: var(--bg-subtle);
    color: var(--brand-sage);
    border: 1px solid var(--brand-sage);
  }

  .status-error {
    display: block;
    background-color: var(--bg-subtle);
    color: #ef4444;
    border: 1px solid #fca5a5;
  }
</style>
