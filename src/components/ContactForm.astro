---
---

<form
  id="contact-form"
  action="/api/submit"
  method="POST"
  class="contact-form"
>
  <!-- Honeypot field to prevent spam bots -->
  <div class="form-group honeypot" style="display: none;">
    <label for="bot_field">Leave this field blank</label>
    <input type="text" id="bot_field" name="bot_field" tabindex="-1" autocomplete="off" />
  </div>

  <div class="form-group">
    <label for="name">Name</label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="Johnny Cash"
      required
      class="form-control"
    />
  </div>

  <div class="form-group">
    <label for="email">Email Address</label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder="johnny@maninblack.com"
      required
      class="form-control"
    />
  </div>

  <div class="form-group">
    <label for="message">Your Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      placeholder="Hello Mat, I'd love to chat about..."
      required
      class="form-control"
    ></textarea>
  </div>

  <div class="form-actions">
    <button type="submit" id="submit-btn" class="btn btn-primary">
      <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
      Send Message
    </button>
  </div>

  <div id="form-status" class="form-status"></div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const statusDiv = document.getElementById('form-status') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      if (submitBtn) submitBtn.disabled = true;
      if (statusDiv) {
        statusDiv.className = 'form-status status-pending';
        statusDiv.textContent = 'Sending message...';
      }

      const formData = new FormData(form);

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        const result = await response.json().catch(() => ({}));

        if (response.ok) {
          if (statusDiv) {
            statusDiv.className = 'form-status status-success';
            statusDiv.textContent = 'Thank you! Your message was sent successfully.';
          }
          form.reset();
        } else {
          if (statusDiv) {
            statusDiv.className = 'form-status status-error';
            statusDiv.textContent = result.message || 'Something went wrong. Please try again.';
          }
        }
      } catch (err) {
        if (statusDiv) {
          statusDiv.className = 'form-status status-error';
          statusDiv.textContent = 'Unable to send message directly. Please feel free to reach out directly via email.';
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  }
</script>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background-color: #151d2a;
    border: 1px solid #232d3f;
    padding: 2rem;
    border-radius: 0.85rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: #cbd5e1;
  }

  .form-control {
    width: 100%;
    padding: 0.75rem 1rem;
    background-color: #0b0f19;
    border: 1px solid #232d3f;
    border-radius: 0.5rem;
    color: #f8fafc;
    font-family: inherit;
    font-size: 0.9375rem;
    transition: border-color 0.2s ease;
  }

  .form-control:focus {
    outline: none;
    border-color: #38bdf8;
  }

  .form-control::placeholder {
    color: #475569;
  }

  textarea.form-control {
    resize: vertical;
    min-height: 120px;
  }

  .form-actions {
    display: flex;
    justify-content: flex-start;
  }

  .form-status {
    min-height: 2rem;
    padding: 0.5rem 0.75rem;
    border-radius: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    display: none;
  }

  .status-pending {
    display: block;
    background-color: #1e293b;
    color: #93c5fd;
    border: 1px solid #334155;
  }

  .status-success {
    display: block;
    background-color: #064e3b;
    color: #6ee7b7;
    border: 1px solid #047857;
  }

  .status-error {
    display: block;
    background-color: #7f1d1d;
    color: #fca5a5;
    border: 1px solid #b91c1c;
  }
</style>
