---

---

<form id="contact-form" action="/api/submit" method="POST" class="contact-form">
  <!-- Honeypot & anti-bot traps (visually hidden off-screen, avoid display:none which bots detect) -->
  <div class="sr-trap" aria-hidden="true">
    <label for="website">Website</label>
    <input
      type="text"
      id="website"
      name="website"
      tabindex="-1"
      autocomplete="off"
    />
    <label for="phone_number">Phone Number</label>
    <input
      type="tel"
      id="phone_number"
      name="phone_number"
      tabindex="-1"
      autocomplete="off"
    />
    <input
      type="text"
      id="bot_field"
      name="bot_field"
      tabindex="-1"
      autocomplete="off"
    />
    <input
      type="hidden"
      id="form_load_time"
      name="form_load_time"
      value=""
    />
  </div>

  <div class="form-group">
    <label for="name">Name</label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="Johnny Cash"
      autocomplete="name"
      enterkeyhint="next"
      data-error="name-error"
      required
      class="form-control"
    />
    <div id="name-error" class="error-msg">
      <span role="img" aria-label="Error">❌</span> Please enter your name.
    </div>
  </div>

  <div class="form-group">
    <label for="email">Email Address</label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder="johnny@maninblack.com"
      autocomplete="email"
      inputmode="email"
      autocorrect="off"
      autocapitalize="none"
      spellcheck="false"
      enterkeyhint="next"
      data-error="email-error"
      required
      class="form-control"
    />
    <div id="email-error" class="error-msg">
      <span role="img" aria-label="Error">❌</span> Enter an email address in the format you@example.com.
    </div>
  </div>

  <div class="form-group">
    <label for="message">Your Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      placeholder="Hello Mat, I'd love to chat about..."
      enterkeyhint="done"
      data-error="message-error"
      required
      class="form-control"></textarea>
    <div id="message-error" class="error-msg">
      <span role="img" aria-label="Error">❌</span> Please enter a message.
    </div>
  </div>

  <div class="form-group turnstile-container">
    <div
      class="cf-turnstile"
      data-sitekey="0x4AAAAAAE9SyXuM57uBV3Vx"
      data-action="contact"
      data-theme="auto"
    ></div>
  </div>

  <div class="form-actions">
    <button type="submit" id="submit-btn" class="btn btn-primary">
      <svg
        aria-hidden="true"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        ><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"></path></svg>
      Send Message
    </button>
  </div>

  <div id="form-status" class="form-status" aria-live="polite"></div>
</form>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  type FormField = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement

  const isFormField = (el: EventTarget | null): el is FormField =>
    el instanceof HTMLInputElement ||
    el instanceof HTMLSelectElement ||
    el instanceof HTMLTextAreaElement

  const linkError = (el: FormField, shown: boolean) => {
    const errorId = el.dataset.error
    if (!errorId) return
    const ids = (el.getAttribute("aria-describedby") || "")
      .split(/\s+/)
      .filter((id) => id && id !== errorId)
    if (shown) ids.push(errorId)
    if (ids.length) el.setAttribute("aria-describedby", ids.join(" "))
    else el.removeAttribute("aria-describedby")
  }

  const getAnnouncer = () => {
    let announcer = document.getElementById("form-live-announcer")
    if (!announcer) {
      announcer = document.createElement("div")
      announcer.id = "form-live-announcer"
      announcer.setAttribute("aria-live", "polite")
      announcer.classList.add("visually-hidden")
      document.body.append(announcer)
    }
    return announcer
  }

  const spokenText = (node: Node) => {
    const copy = node.cloneNode(true) as Element
    copy.querySelectorAll('[aria-hidden="true"]').forEach((n) => n.remove())
    copy.querySelectorAll('[role="img"][aria-label]').forEach((n) => {
      n.replaceWith(`${n.getAttribute("aria-label")}: `)
    })
    return (copy.textContent || "").replace(/\s+/g, " ").trim()
  }

  let announceTimer: ReturnType<typeof setTimeout> | undefined
  let announcedField: FormField | undefined

  const announceError = (el: FormField) => {
    const errorId = el.dataset.error
    if (!errorId) return
    const error = document.getElementById(errorId)
    if (!error) return
    const label = el.labels?.[0] ? `${spokenText(el.labels[0])}: ` : ""
    const announcer = getAnnouncer()
    clearTimeout(announceTimer)
    announcer.textContent = ""
    announcedField = el
    announceTimer = setTimeout(() => {
      announcer.textContent = label + spokenText(error)
    }, 500)
  }

  const initFieldValidation = (form: HTMLFormElement) => {
    const supportsUserInvalid = CSS.supports("selector(:user-invalid)")
    const dirtyState = new WeakMap<FormField, { hasInteracted: boolean; hasBlurred: boolean }>()
    const flagged = new WeakSet<FormField>()
    const announced = new WeakSet<FormField>()
    const fields = form.querySelectorAll<FormField>("input, select, textarea")

    const syncField = (el: FormField, announce = false, forceFallbackState?: boolean) => {
      if (el.type === "hidden" || el.closest("[aria-hidden='true']")) return

      const invalid =
        typeof forceFallbackState === "boolean"
          ? forceFallbackState
          : supportsUserInvalid
            ? el.matches(":user-invalid")
            : el.classList.contains("user-invalid-fallback")

      if (invalid) {
        if (announce && !announced.has(el)) {
          announceError(el)
          announced.add(el)
        }
        el.setAttribute("aria-invalid", "true")
        linkError(el, true)
        flagged.add(el)
      } else if (flagged.has(el) || el.getAttribute("aria-invalid") !== "true") {
        el.setAttribute("aria-invalid", "false")
        linkError(el, false)
        flagged.delete(el)
        announced.delete(el)
        if (announcedField === el) {
          clearTimeout(announceTimer)
          getAnnouncer().textContent = ""
        }
      }
    }

    const updateFallback = (el: FormField, announce = false) => {
      const isValid = el.validity.valid
      el.classList.toggle("user-invalid-fallback", !isValid)
      el.classList.toggle("user-valid-fallback", isValid)
      syncField(el, announce, !isValid)
    }

    fields.forEach((el) => {
      if (el.type !== "hidden" && !el.closest("[aria-hidden='true']")) {
        syncField(el)
      }
    })

    form.addEventListener(
      "blur",
      (e) => {
        if (!isFormField(e.target)) return
        if (supportsUserInvalid) {
          syncField(e.target, true)
          return
        }
        const state = dirtyState.get(e.target) || { hasInteracted: false, hasBlurred: false }
        state.hasBlurred = true
        dirtyState.set(e.target, state)
        if (state.hasInteracted) updateFallback(e.target, true)
      },
      true
    )

    form.addEventListener("input", (e) => {
      if (!isFormField(e.target)) return
      if (supportsUserInvalid) {
        if (e.target.hasAttribute("aria-invalid")) syncField(e.target)
        return
      }
      const state = dirtyState.get(e.target) || { hasInteracted: false, hasBlurred: false }
      state.hasInteracted = true
      dirtyState.set(e.target, state)
      if (state.hasBlurred) updateFallback(e.target)
    })

    form.addEventListener(
      "change",
      (e) => {
        if (!isFormField(e.target)) return
        if (supportsUserInvalid) {
          syncField(e.target, true)
          return
        }
        const state = dirtyState.get(e.target) || { hasInteracted: false, hasBlurred: false }
        state.hasInteracted = true
        dirtyState.set(e.target, state)
        if (state.hasBlurred) updateFallback(e.target, true)
      },
      true
    )

    form.addEventListener(
      "invalid",
      (e) => {
        if (!isFormField(e.target)) return
        announced.add(e.target)
        if (supportsUserInvalid) {
          syncField(e.target)
          return
        }
        dirtyState.set(e.target, { hasInteracted: true, hasBlurred: true })
        updateFallback(e.target)
      },
      true
    )

    form.addEventListener("reset", () => {
      setTimeout(() => {
        fields.forEach((el) => {
          dirtyState.delete(el)
          el.classList.remove("user-invalid-fallback", "user-valid-fallback")
          syncField(el, false, false)
        })
      })
    })
  }

  // Handle client-side transitions and initial load in Astro (ClientRouter)
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null
    if (!form) return

    const statusDiv = document.getElementById("form-status") as HTMLDivElement | null
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null
    const loadTimeInput = document.getElementById("form_load_time") as HTMLInputElement | null

    // Initialize load timestamp for anti-bot time-trap
    if (loadTimeInput) {
      loadTimeInput.value = Date.now().toString()
    }

    initFieldValidation(form)

    if (typeof (window as any).turnstile !== "undefined") {
      const widgetEl = document.querySelector(".cf-turnstile")
      if (widgetEl && !widgetEl.hasChildNodes()) {
        try {
          ;(window as any).turnstile.render(widgetEl, {
            sitekey: "0x4AAAAAAE9SyXuM57uBV3Vx",
            action: "contact",
            theme: "auto",
          })
        } catch {}
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault()

      if (submitBtn) submitBtn.disabled = true
      if (statusDiv) {
        statusDiv.removeAttribute("role")
        statusDiv.className = "form-status status-pending"
        statusDiv.textContent = "Sending message..."
      }

      const formData = new FormData(form)

      try {
        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: {
            Accept: "application/json",
          },
        })

        type FormResponse = { message?: string }
        const result = (await response.json().catch(() => ({}))) as FormResponse

        if (response.ok) {
          if (statusDiv) {
            statusDiv.setAttribute("role", "status")
            statusDiv.className = "form-status status-success"
            statusDiv.textContent =
              "Thank you! Your message was sent successfully."
          }
          form.reset()
          if (loadTimeInput) {
            loadTimeInput.value = Date.now().toString()
          }
        } else {
          if (statusDiv) {
            statusDiv.setAttribute("role", "status")
            statusDiv.className = "form-status status-error"
            statusDiv.textContent =
              result.message || "Something went wrong. Please try again later."
          }
        }
      } catch {
        if (statusDiv) {
          statusDiv.setAttribute("role", "status")
          statusDiv.className = "form-status status-error"
          statusDiv.textContent =
            "Unable to send message directly. Please feel free to reach out directly via email."
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false
        // Turnstile tokens are single-use; reset widget for any subsequent attempts
        if (typeof (window as any).turnstile !== "undefined") {
          try {
            ;(window as any).turnstile.reset()
          } catch {}
        }
      }
    })
  })
</script>

<style>
  /* Visually hide anti-bot decoy fields without triggering bot display:none heuristics */
  .sr-trap {
    position: absolute;
    left: -9999px;
    top: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 2rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-control {
    width: 100%;
    min-block-size: 48px;
    padding: 0.75rem 1rem;
    background-color: var(--bg-app);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font: inherit;
    font-size: max(1rem, 1em);
    transition: border-color 0.2s ease;
  }

  @media (pointer: coarse) {
    .form-control {
      min-block-size: 52px;
    }
  }

  .form-control:focus-visible {
    outline: 2px solid var(--brand-sage);
    outline-offset: 2px;
    border-color: var(--brand-sage);
  }

  .form-control:is(:user-invalid, .user-invalid-fallback) {
    border-color: var(--status-error);
  }

  .form-control:is(:user-valid, .user-valid-fallback) {
    border-color: var(--brand-sage);
  }

  .error-msg {
    display: none;
    color: var(--status-error);
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }

  .form-control:is(:user-invalid, .user-invalid-fallback) + .error-msg {
    display: block;
  }

  .form-control::placeholder {
    color: var(--text-primary);
    opacity: 0.5;
  }

  textarea.form-control {
    resize: vertical;
    min-height: 120px;
  }

  .form-actions {
    display: flex;
    justify-content: flex-start;
  }

  .form-status {
    min-height: 2rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    display: none;
  }

  .status-pending {
    display: block;
    background-color: var(--bg-subtle);
    color: var(--text-primary);
    border: 1px solid var(--border-color);
  }

  .status-success {
    display: block;
    background-color: var(--bg-subtle);
    color: var(--brand-sage);
    border: 1px solid var(--brand-sage);
  }

  .status-error {
    display: block;
    background-color: var(--bg-subtle);
    color: var(--status-error);
    border: 1px solid var(--status-error-border);
  }
</style>
