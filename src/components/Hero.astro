---
import { Image } from 'astro:assets';
import profilePic from '../assets/images/icon.png';
---

<section class="hero-section">
  <div class="container hero-container">
    <div class="hero-content">
      <div class="location-badge">
        <span class="status-dot"></span>
        Calgary, AB 🇨🇦
      </div>
      
      <h1 class="hero-headline">
        Hi, I'm <span class="highlight">Mat</span>!
      </h1>
      
      <p class="hero-subtitle">
        I'm a <strong>Full-Stack Engineer</strong> currently at <strong>ZayZoon</strong>. Born in frontend development, I combine 4+ years of Ruby on Rails experience with modern React, TypeScript, and Node.js to build fast, intuitive web applications.
      </p>

      <div class="hero-actions">
        <a href="/projects/" class="btn btn-primary">
          View Projects
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/about/" class="btn btn-secondary">
          About Me
        </a>
      </div>
    </div>

    <div class="hero-avatar-wrapper">
      <div class="avatar-card">
        <Image 
          src={profilePic} 
          alt="Mateus Tavares" 
          width={280} 
          height={280} 
          class="hero-avatar"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    padding: 4.5rem 0 3rem 0;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    align-items: center;
    gap: 3rem;
  }

  @media (max-width: 768px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
    }
  }

  .location-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--brand-sage);
    margin-bottom: 1.25rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--brand-sage);
    display: inline-block;
  }

  .hero-headline {
    font-size: 3.25rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 640px) {
    .hero-headline {
      font-size: 2.35rem;
    }
  }

  .highlight {
    color: var(--brand-gold);
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--text-primary);
    opacity: 0.8;
    line-height: 1.65;
    margin-bottom: 2rem;
    max-width: 620px;
  }

  .hero-subtitle strong {
    color: var(--text-primary);
    opacity: 1;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero-actions {
      justify-content: center;
    }
  }

  .hero-avatar-wrapper {
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .avatar-card {
    position: relative;
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    padding: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.2);
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .hero-avatar {
    width: 100%;
    max-width: 280px;
    height: auto;
    display: block;
    border-radius: 1.25rem;
    margin: 0;
  }
</style>
