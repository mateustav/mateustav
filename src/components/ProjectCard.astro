---
import { Image } from 'astro:assets';

interface Props {
  title: string;
  featuredImage?: any;
  tech: string[];
  link?: string;
  github?: string;
  Content?: any;
}

const { title, featuredImage, tech = [], link, github, Content } = Astro.props;
---

<article class="project-card" data-tech={JSON.stringify(tech)}>
  <div class="card-image-wrapper">
    {featuredImage && (
      <Image
        src={featuredImage}
        alt={title}
        width={600}
        height={340}
        class="project-image"
      />
    )}
  </div>

  <div class="card-body">
    <div class="card-header">
      <h3 class="project-title">{title}</h3>
      <div class="tech-tags">
        {tech.map((t) => (
          <span class="badge">{t}</span>
        ))}
      </div>
    </div>

    <div class="project-description prose">
      {Content ? <Content /> : <slot />}
    </div>

    <div class="card-footer">
      {link && (
        <a href={link} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
          <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          Visit Site
        </a>
      )}

      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
          GitHub
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 0.85rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--brand-gold);
    background-color: var(--bg-subtle);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    height: 200px;
    background-color: var(--bg-app);
    overflow: hidden;
    border-bottom: 1px solid var(--border-color);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.03);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-header {
    margin-bottom: 1rem;
  }

  .project-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .project-description {
    color: var(--text-primary);
    opacity: 0.8;
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .project-description ul {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  .btn-sm {
    padding: 0.45rem 0.85rem;
    font-size: 0.8125rem;
  }
</style>
