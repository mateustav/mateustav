---
import { Image } from "astro:assets"
import { icon } from "@fortawesome/fontawesome-svg-core"
import { faGithub, faChrome, faFirefox } from "@fortawesome/free-brands-svg-icons"
import { faArrowUpRightFromSquare } from "@fortawesome/free-solid-svg-icons"

interface Props {
  title: string
  featuredImage?: any
  tech: string[]
  link?: string
  github?: string
  chrome?: string
  firefox?: string
  Content?: any
}

const { title, featuredImage, tech = [], link, github, chrome, firefox, Content } = Astro.props

const githubSvg = icon(faGithub)?.html[0] || ""
const chromeSvg = icon(faChrome)?.html[0] || ""
const firefoxSvg = icon(faFirefox)?.html[0] || ""
const linkSvg = icon(faArrowUpRightFromSquare)?.html[0] || ""
---

<article class="project-card" data-tech={JSON.stringify(tech)}>
  <div class="card-image-wrapper">
    {
      featuredImage && (
        <Image
          src={featuredImage}
          alt={title}
          width={600}
          height={340}
          class="project-image"
        />
      )
    }
  </div>

  <div class="card-body">
    <div class="card-header">
      <h3 class="project-title">{title}</h3>
      <div class="tech-tags">
        {tech.map((t) => <span class="badge">{t}</span>)}
      </div>
    </div>

    <div class="project-description prose">
      {Content ? <Content /> : <slot />}
    </div>

    <div class="card-footer">
      {
        link && (
          <a
            href={link}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-primary btn-sm icon-btn"
            aria-label="Visit Site"
            title="Visit Site"
          >
            <Fragment set:html={linkSvg} />
          </a>
        )
      }

      {
        chrome && (
          <a
            href={chrome}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-sm icon-btn"
            aria-label="Chrome Store"
            title="Chrome Store"
          >
            <Fragment set:html={chromeSvg} />
          </a>
        )
      }

      {
        firefox && (
          <a
            href={firefox}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-sm icon-btn"
            aria-label="Firefox Add-ons"
            title="Firefox Add-ons"
          >
            <Fragment set:html={firefoxSvg} />
          </a>
        )
      }

      {
        github && (
          <a
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary btn-sm icon-btn"
            aria-label="GitHub Repository"
            title="GitHub Repository"
          >
            <Fragment set:html={githubSvg} />
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    background-color: var(--bg-card);
    border: 1px solid var(--border-color);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: all 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--brand-sage);
    background-color: var(--bg-subtle);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    height: 200px;
    background-color: var(--bg-app);
    overflow: hidden;
    border-bottom: 1px solid var(--border-color);
  }

  .project-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.03);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-header {
    margin-bottom: 1rem;
  }

  .project-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .project-description {
    color: var(--text-primary);
    opacity: 0.8;
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .project-description ul {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
  }

  .btn-sm {
    padding: 0.45rem 0.85rem;
    font-size: 0.8125rem;
  }

  .icon-btn {
    padding: 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .icon-btn :global(svg) {
    width: 18px;
    height: 18px;
    display: block;
    fill: currentColor;
  }
</style>
