  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "featuredImage": {
      "type": "string"
    },
    "link": {
      "type": "string"
    },
    "github": {
      "type": "string"
    },
    "order": {
      "default": 99,
